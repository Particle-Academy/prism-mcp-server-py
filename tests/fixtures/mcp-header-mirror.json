      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header is present but the request body has no value for it." }
    },
    {
      "id": "hdr-0123", "title": "a header with no arguments at all",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "headers": [["Mcp-Param-Region", "us-west1"]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header is present but the request body has no value for it." }
    },
    {
      "id": "hdr-0124", "title": "a header the tool does not declare",
