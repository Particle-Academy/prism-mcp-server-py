      "id": "hdr-0133", "title": "a body integer outside the safe range",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "replicas": 9007199254740993 },
      "headers": [["Mcp-Param-Replicas", "9007199254740993"]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the request body value for [Mcp-Param-Replicas] is not a valid integer." }
