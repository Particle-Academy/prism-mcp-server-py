      "expect": { "outcome": "refused", "message": "Header mismatch: a header that mirrors the request body is repeated." }
    },
    {
      "id": "hdr-0110", "title": "the same header twice in different case",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
      "headers": [["Mcp-Param-Region", "us-west1"], ["mcp-param-region", "eu-west1"]],
