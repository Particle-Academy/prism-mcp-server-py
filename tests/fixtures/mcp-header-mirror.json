      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Replicas] header does not match the request body." }
    },
    {
      "id": "hdr-0129", "title": "an integer in hexadecimal",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "replicas": 3 },
      "headers": [["Mcp-Param-Replicas", "0x3"]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Replicas] header does not match the request body." }
    },
    {
      "id": "hdr-0130", "title": "a fraction",
      "revision": "2026-07-28", "tool": "route", "standard": true,
