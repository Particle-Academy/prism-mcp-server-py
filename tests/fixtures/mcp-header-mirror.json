    },
    {
      "id": "hdr-0112", "title": "raw non-ASCII bytes instead of the sentinel",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "Hello, 世界" },
      "headers": [["Mcp-Param-Region", "Hello, 世界"]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header value is malformed." }
    },
    {
      "id": "hdr-0113", "title": "Base64 without its padding",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "Hello" },
      "headers": [["Mcp-Param-Region", "=?base64?SGVsbG8?="]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header value is malformed." }
    },
    {
      "id": "hdr-0114", "title": "Base64 with interior whitespace",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "Hello" },
      "headers": [["Mcp-Param-Region", "=?base64?SGVs bG8=?="]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header value is malformed." }
    },
    {
      "id": "hdr-0115", "title": "the URL-safe Base64 alphabet",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "Hello" },
      "headers": [["Mcp-Param-Region", "=?base64?SGVsbG8_?="]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header value is malformed." }
    },
    {
      "id": "hdr-0116", "title": "Base64 that decodes to invalid UTF-8",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "Hello" },
      "headers": [["Mcp-Param-Region", "=?base64?/w==?="]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header value is malformed." }
    },
    {
      "id": "hdr-0117", "title": "the sentinel markers are case-sensitive, so an uppercase one is a literal value",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "Hello" },
      "headers": [["Mcp-Param-Region", "=?BASE64?SGVsbG8=?="]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header does not match the request body." }
    },
    {
      "id": "hdr-0118", "title": "a value encoded twice is decoded once",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "Hello" },
