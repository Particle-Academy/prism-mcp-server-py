    },
    {
      "id": "hdr-0105", "title": "a hyphen homoglyph (U+2010) in the sentinel",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
      "headers": [["Mcp-Param-Region", "=?base64?dXPigJB3ZXN0MQ==?="]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header does not match the request body." }
    },
    {
      "id": "hdr-0106", "title": "a Cyrillic homoglyph (U+0435) in the sentinel",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
      "headers": [["Mcp-Param-Region", "=?base64?dXMtd9C1c3Qx?="]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header does not match the request body." }
    },
    {
      "id": "hdr-0107", "title": "padding in the body cannot be matched by a raw header, whose whitespace is stripped",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": " us-west1" },
      "headers": [["Mcp-Param-Region", " us-west1"]],
