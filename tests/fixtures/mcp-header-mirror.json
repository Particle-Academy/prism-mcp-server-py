    },
    {
      "id": "hdr-0108", "title": "a trailing space the header does not carry",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1 " },
      "headers": [["Mcp-Param-Region", "=?base64?dXMtd2VzdDE=?="]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header does not match the request body." }
    },
    {
      "id": "hdr-0109", "title": "the same header twice with the same value",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
