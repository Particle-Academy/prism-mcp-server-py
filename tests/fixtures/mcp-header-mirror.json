{
  "suite": "mcp-header-mirror",
  "schema_version": 1,
  "corpus_version": "0.1.0",
  "spec": "MCP 2026-07-28, basic/transports/streamable-http.mdx: Request Metadata, Value Encoding, Server Behavior for Custom Headers, Case Sensitivity and Server Validation.",
  "shared_by": "prism-mcp-server-ts test/fixtures/mcp-header-mirror.json and prism-mcp-server-py tests/fixtures/mcp-header-mirror.json carry these exact bytes. Both suites pin the same SHA-256, so a row changed in one language and not the other fails both.",
  "harness": {
    "transport": "Each row is one POST to the real loopback HTTP server, written byte for byte on a raw socket, so header names, casing, repeats and non-ASCII bytes reach the server exactly as listed. Header values are sent as their UTF-8 bytes.",
    "always_sent": "Host, Authorization (the listener's bearer token), Content-Type: application/json, Accept: application/json, Content-Length and Connection: close.",
    "standard": "When a row has \"standard\": true, a 2026-07-28 row also sends MCP-Protocol-Version: 2026-07-28, Mcp-Method: tools/call and Mcp-Name: <tool>. A handshake-revision row sends MCP-Protocol-Version: <revision> for 2025-06-18 and later, and nothing for the two earlier revisions, which had no such header.",
    "body": "A 2026-07-28 row carries the per-request _meta (protocolVersion, clientCapabilities, clientInfo). A handshake-revision row carries no _meta. A row without \"arguments\" sends none.",
    "outcomes": {
      "served": "HTTP 200. The tool ran once and saw exactly \"arguments\", and its context saw exactly \"headers\" (lowercased mirror name to decoded value).",
      "refused": "HTTP 400 with the JSON-RPC error code -32020 and exactly \"message\". Neither the gate nor the tool ran.",
      "unregistered": "HTTP 200 with the JSON-RPC error code -32000 and data.code tool_call_failed, as for any unknown tool. Neither the gate nor the tool ran."
    }
  },
  "tools": [
    {
      "name": "route",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": { "type": "string", "x-mcp-header": "Region" },
          "replicas": { "type": "integer", "x-mcp-header": "Replicas" },
          "dry": { "type": "boolean", "x-mcp-header": "Dry" },
          "placement": {
            "type": "object",
            "properties": { "zone": { "type": "string", "x-mcp-header": "Zone" } }
          },
          "query": { "type": "string" }
        }
      }
    },
    {
      "name": "plain",
      "inputSchema": { "type": "object", "properties": { "query": { "type": "string" } } }
    }
  ],
  "cases": [
    {
      "id": "hdr-0001", "title": "a plain value that matches the body",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
      "headers": [["Mcp-Param-Region", "us-west1"]],
      "expect": { "outcome": "served", "arguments": { "region": "us-west1" }, "headers": { "region": "us-west1" } }
    },
    {
      "id": "hdr-0002", "title": "header names are case-insensitive",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
      "headers": [["mCp-pArAm-rEgIoN", "us-west1"]],
      "expect": { "outcome": "served", "arguments": { "region": "us-west1" }, "headers": { "region": "us-west1" } }
    },
    {
      "id": "hdr-0003", "title": "optional whitespace around a field value is not part of it",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
      "headers": [["Mcp-Param-Region", "  us-west1\t"]],
      "expect": { "outcome": "served", "arguments": { "region": "us-west1" }, "headers": { "region": "us-west1" } }
    },
    {
      "id": "hdr-0004", "title": "a non-ASCII value in the Base64 sentinel",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "Hello, 世界" },
      "headers": [["Mcp-Param-Region", "=?base64?SGVsbG8sIOS4lueVjA==?="]],
      "expect": { "outcome": "served", "arguments": { "region": "Hello, 世界" }, "headers": { "region": "Hello, 世界" } }
    },
    {
      "id": "hdr-0005", "title": "leading and trailing spaces survive only inside the sentinel",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": " padded " },
      "headers": [["Mcp-Param-Region", "=?base64?IHBhZGRlZCA=?="]],
      "expect": { "outcome": "served", "arguments": { "region": " padded " }, "headers": { "region": " padded " } }
    },
    {
      "id": "hdr-0006", "title": "a value that looks like the sentinel is itself encoded",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "=?base64?literal?=" },
      "headers": [["Mcp-Param-Region", "=?base64?PT9iYXNlNjQ/bGl0ZXJhbD89?="]],
      "expect": { "outcome": "served", "arguments": { "region": "=?base64?literal?=" }, "headers": { "region": "=?base64?literal?=" } }
    },
    {
      "id": "hdr-0007", "title": "the empty string in the sentinel",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "" },
      "headers": [["Mcp-Param-Region", "=?base64??="]],
      "expect": { "outcome": "served", "arguments": { "region": "" }, "headers": { "region": "" } }
    },
    {
      "id": "hdr-0008", "title": "an integer",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "replicas": 3 },
      "headers": [["Mcp-Param-Replicas", "3"]],
      "expect": { "outcome": "served", "arguments": { "replicas": 3 }, "headers": { "replicas": "3" } }
    },
    {
      "id": "hdr-0009", "title": "integers compare numerically: 3.0 is 3",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "replicas": 3 },
      "headers": [["Mcp-Param-Replicas", "3.0"]],
      "expect": { "outcome": "served", "arguments": { "replicas": 3 }, "headers": { "replicas": "3.0" } }
    },
    {
      "id": "hdr-0010", "title": "an encoded integer is decoded before it is compared",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "replicas": 3 },
      "headers": [["Mcp-Param-Replicas", "=?base64?Mw==?="]],
      "expect": { "outcome": "served", "arguments": { "replicas": 3 }, "headers": { "replicas": "3" } }
    },
    {
      "id": "hdr-0011", "title": "the largest safe integer",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "replicas": 9007199254740991 },
      "headers": [["Mcp-Param-Replicas", "9007199254740991"]],
      "expect": { "outcome": "served", "arguments": { "replicas": 9007199254740991 }, "headers": { "replicas": "9007199254740991" } }
    },
    {
      "id": "hdr-0012", "title": "a boolean",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "dry": false },
      "headers": [["Mcp-Param-Dry", "false"]],
      "expect": { "outcome": "served", "arguments": { "dry": false }, "headers": { "dry": "false" } }
    },
    {
      "id": "hdr-0013", "title": "a nested property",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "placement": { "zone": "b" }, "query": "q" },
      "headers": [["Mcp-Param-Zone", "b"]],
      "expect": { "outcome": "served", "arguments": { "placement": { "zone": "b" }, "query": "q" }, "headers": { "zone": "b" } }
    },
    {
      "id": "hdr-0014", "title": "every mirror at once",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "eu", "replicas": -7, "dry": true, "placement": { "zone": "a" } },
      "headers": [["Mcp-Param-Zone", "a"], ["Mcp-Param-Dry", "true"], ["Mcp-Param-Replicas", "-7"], ["Mcp-Param-Region", "eu"]],
      "expect": { "outcome": "served", "arguments": { "region": "eu", "replicas": -7, "dry": true, "placement": { "zone": "a" } }, "headers": { "region": "eu", "replicas": "-7", "dry": "true", "zone": "a" } }
    },
    {
      "id": "hdr-0015", "title": "a null value is not mirrored, so no header is expected",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": null },
      "headers": [],
      "expect": { "outcome": "served", "arguments": { "region": null }, "headers": {} }
    },
    {
      "id": "hdr-0016", "title": "an absent value is not mirrored, so no header is expected",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "query": "only the body" },
      "headers": [],
      "expect": { "outcome": "served", "arguments": { "query": "only the body" }, "headers": {} }
    },
    {
      "id": "hdr-0017", "title": "an encoded Mcp-Name is decoded before it is compared",
      "revision": "2026-07-28", "tool": "route", "standard": false,
      "arguments": { "region": "us-west1" },
      "headers": [["MCP-Protocol-Version", "2026-07-28"], ["Mcp-Method", "tools/call"], ["Mcp-Name", "=?base64?cm91dGU=?="], ["Mcp-Param-Region", "us-west1"]],
      "expect": { "outcome": "served", "arguments": { "region": "us-west1" }, "headers": { "region": "us-west1" } }
    },
    {
      "id": "hdr-0018", "title": "the standard headers are not yet required: the published prism-mcp clients do not send them",
      "revision": "2026-07-28", "tool": "route", "standard": false,
      "arguments": { "region": "us-west1" },
      "headers": [["Mcp-Param-Region", "us-west1"]],
      "expect": { "outcome": "served", "arguments": { "region": "us-west1" }, "headers": { "region": "us-west1" } }
    },
    {
      "id": "hdr-0101", "title": "a missing header for a value the body carries",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
      "headers": [],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header is required." }
    },
    {
      "id": "hdr-0102", "title": "a missing header for a nested value",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1", "placement": { "zone": "b" } },
      "headers": [["Mcp-Param-Region", "us-west1"]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Zone] header is required." }
    },
    {
      "id": "hdr-0103", "title": "a different value",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
      "headers": [["Mcp-Param-Region", "eu-west1"]],
      "expect": { "outcome": "refused", "message": "Header mismatch: the [Mcp-Param-Region] header does not match the request body." }
    },
    {
      "id": "hdr-0104", "title": "values are case-sensitive",
      "revision": "2026-07-28", "tool": "route", "standard": true,
      "arguments": { "region": "us-west1" },
